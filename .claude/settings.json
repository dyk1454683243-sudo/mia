{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh repo view:*)",
      "Bash(gh label:*)",
      "Bash(gh auth status:*)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth token:*)",
      "Bash(gh secret:*)",
      "Bash(gh ruleset:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
